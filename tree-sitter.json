{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "flow",
      "camelcase": "Flow",
      "title": "Flow",
      "scope": "source.flow",
      "path": ".",
      "file-types": [
        "flow"
      ],
      "content-regex": "@flow",
      "highlights": [
        "node_modules/tree-sitter-javascript/queries/highlights.scm",
        "queries/highlights.scm"
      ],
      "locals": [
        "node_modules/tree-sitter-javascript/queries/locals.scm",
        "queries/locals.scm"
      ],
      "tags": [
        "node_modules/tree-sitter-javascript/queries/tags.scm",
        "queries/tags.scm"
      ],
      "injections": [
        "node_modules/tree-sitter-javascript/queries/injections.scm",
        "queries/injections.scm"
      ],
      "injection-regex": "^flow$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Flow grammar for tree-sitter",
    "authors": [
      {
        "name": "Vladimir Makaev",
        "email": "vmakaev@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/VladimirMakaev/tree-sitter-flow"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
