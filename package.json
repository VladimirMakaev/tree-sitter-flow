{
  "name": "tree-sitter-flow",
  "version": "0.1.0",
  "description": "Flow grammar for tree-sitter",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VladimirMakaev/tree-sitter-flow.git"
  },
  "license": "MIT",
  "author": {
    "name": "Vladimir Makaev",
    "email": "vmakaev@gmail.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "flow"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "flow-parser": "0.342.0",
    "hermes-parser": "0.37.0",
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "0.27.2",
    "tree-sitter-javascript": "0.25.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "generate": "tree-sitter generate --abi=14",
    "test:corpus": "tree-sitter test",
    "suites:fetch": "bash script/fetch-suites.sh",
    "suites": "node script/run-suites.mjs",
    "compare": "node script/compare.mjs",
    "mapping-table": "node script/mapping-table.mjs",
    "test:scripts": "node --test script/convert.test.mjs"
  }
}
